# Godot 4+ specific ignores
.godot/
/android/
.mcp.json

# Original packages stay on disk; retain textual licensing evidence separately.
/资产/

# Reproducible local Demo bundles; retain build evidence and source in Git.
/交付/

# Local Python bytecode from evidence tooling.
**/__pycache__/
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Local archives, download caches and transient native compiler files.
/备份/
/废弃/
# Local verification captures are intentionally kept outside the published source tree.
/验证记录/
# Full reference originals remain at their existing local paths. Only the
# already tracked documentation, selected algorithms and shaders are published.
/参考资料/
# Retired 2.5D outputs and the unused native extension stay in local archives.
/资源/P0城市/
/资源/Demo城市/
/资源/精制河湾/
/资源/美术候选/
/资源/风格小景/
/资源/时代城市/
/资源/古典建筑候选/
/资源/街坊建筑变体/
/资源/首作声音路线/
/资源/测试/
/资源/着色器/
/addons/city_audio/
/native/city_audio/
/数据/兼容规格/

# Standalone test scripts load by res:// path; editor-generated UIDs are not inputs.
/tests/**/*.gd.uid

# Local UI reference checkout; adapted source lives in scripts/ui.
/UI/

# Rebuildable local PCM bank and generated standalone tool UIDs.
/资源/音乐/城市同步声部库.res
/tools/**/*.gd.uid

# User phase-three source pack stays unchanged locally.
/新新新文档/

# Superseded source packs and duplicate workspaces, retired by the user.
/新文档/
/AI资料/
/work/
